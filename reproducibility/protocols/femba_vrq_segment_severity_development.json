{
  "schema": "femba_vrq_segment_severity_development_v1",
  "revision": "locked_20260911",
  "dataset": "vrq",
  "task": "severity_segment",
  "model_input_mode": "state_identical_single_window_tokens",
  "variant": "A3_pretrained_frozen",
  "outer_fold": "fold_1",
  "seeds": [2001, 3001, 4001],
  "configs": ["base", "mlp", "poly", "fractional", "dog"],
  "development_splits": {
    "split_1": {"val_subjects": ["sub5", "sub15", "sub22", "sub10", "sub13", "sub18"]},
    "split_2": {"val_subjects": ["sub1", "sub4", "sub21", "sub7", "sub16", "sub19"]},
    "split_3": {"val_subjects": ["sub2", "sub12", "sub23", "sub8", "sub17", "sub20"]}
  },
  "sample_definition": "every_complete_five_second_window_from_final_task_session",
  "label_definition": "subject_final_ssq_binary_label_inherited_by_each_task_window",
  "weak_supervision": true,
  "identity_split_unit": "subject",
  "primary_evaluation_unit": "five_second_window",
  "secondary_audit_unit": "subject_mean_probability",
  "preprocessing": "subject_unlabeled_EA_all_protocol_windows_float32",
  "offline_transductive_subject_EA": true,
  "reference_calibration": false,
  "anchor_input": false,
  "rest_identity_input": false,
  "outer_test_eeg_loaded": false,
  "outer_test_labels_used_for_fit_selection_or_scoring": false,
  "architecture": "unchanged_VRQBoostedHead_state_mode",
  "base_training": "train_and_select_once_per_seed_and_split_then_freeze_exact_best_base",
  "residual_training": "train_only_mapping_and_binary_residual_on_shared_frozen_base",
  "loss": "window_level_binary_BCE_only",
  "head_lr": 0.001,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "batch_size": {"state": 32},
  "microbatch_size": {"state": 4},
  "max_epochs": 60,
  "patience_epochs": 10,
  "selection": "minimum_unweighted_source_val_window_BCE_earliest_step_tie",
  "validation": "first_step_then_global_multiples_of_ceil_N_over_4_and_epoch_end",
  "threshold": 0.5,
  "primary_metric": "window_balanced_accuracy",
  "development_only": true,
  "promotion_rule": {
    "dog_minus_mlp_mean_BACC_positive": true,
    "dog_minus_poly_mean_BACC_positive": true,
    "dog_positive_runs_minimum_of_nine": 6,
    "dog_ablation_must_reduce_performance": true
  },
  "limits": [
    "City data, code paths, checkpoints and result artifacts are not read or modified by this protocol.",
    "Windows inherit a subject-level post-task severity label and are correlated weakly supervised samples, not independent subjects.",
    "Train and validation are strictly subject-disjoint; no subject contributes windows to both partitions.",
    "Only final-task windows enter severity classification; no rest window or rest identity is a model input.",
    "Subject-wide unlabeled EA is retained and explicitly transductive.",
    "Five outer-test subjects remain excluded and no outer-test evaluation is automatically triggered.",
    "Primary window metrics must be accompanied by subject-clustered or subject-aggregated audit metrics in any paper report."
  ]
}
